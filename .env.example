# Django reads process environment variables, not this file automatically.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DJANGO_ALLOWED_HOSTS=your-hostname.example
DJANGO_CSRF_ORIGINS=https://your-hostname.example
POSTGRES_DB=ecotwin
POSTGRES_USER=ecotwin
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MEDIA_ROOT=/persistent/eco-twin-media
